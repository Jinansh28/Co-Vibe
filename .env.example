# Frontend Environment Variables (apps/web)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_RUNTIME_URL=http://127.0.0.1:7890
VITE_API_URL=
VITE_WS_URL=

# API / Worker Environment Variables (apps/api)
ENVIRONMENT=development
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
RUNTIME_JWT_SECRET=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
GITHUB_TOKEN_ENCRYPTION_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Database (scripts/migrate.ts)
DATABASE_URL=

# Local Runtime & Sandbox Environment Variables (apps/runtime)
RUNTIME_SERVER_URL=http://localhost:8787
RUNTIME_ID=rt_local_dev
RUNTIME_PORT=7890
RUNTIME_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SANDBOX_DOCKER_IMAGE=co-vibe-sandbox

# AI Provider (Set GEMINI_API_KEY to use Gemini, otherwise defaults to local Ollama)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
